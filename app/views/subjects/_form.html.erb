<%= simple_form_for(subject) do |form| %>
  <% if subject.errors.any? %>
    <div class="alert alert-danger">
      <h5>
        <%= pluralize(subject.errors.count, "error") %>
        prohibited this subject from being saved:
      </h5>

      <ul class="mb-0">
        <% subject.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="mb-3">
    <%= form.input :name,
                   label: "Subject Name",
                   input_html: { class: "form-control" } %>
  </div>

  <div class="mb-3">
    <%= form.input :teacher_id,
                   label: "Teacher",
                   collection: Teacher.order(:name),
                   value_method: :id,
                   label_method: :name,
                   prompt: "Select a teacher",
                   input_html: { class: "form-select" } %>
  </div>

  <div class="mt-4">
    <%= form.button :submit, class: "btn btn-primary" %>
  </div>
<% end %>
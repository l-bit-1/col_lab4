<p style="color: green"><%= notice %></p>

<%= render @subject %>

<% if @subject.sections.any? %>
  <h2>Sections</h2>

  <% @subject.sections.each do |section| %>
    <h3><%= section.name %></h3>
    <p>
      Room: <%= section.room %> |
      Timeslot: <%= section.timeslot %> |
      Teacher: <%= @subject.teacher.name %>
    </p>

    <% if section.classlists.any? %>
      <table>
        <thead>
          <tr>
            <th>Name</th>
            <th>Year Level</th>
            <th>Program</th>
          </tr>
        </thead>
        <tbody>
          <% section.classlists.each do |classlist| %>
            <tr>
              <td><%= classlist.student.name %></td>
              <td><%= classlist.student.year_level %></td>
              <td><%= classlist.student.program %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% else %>
      <p>No students enrolled in this section yet.</p>
    <% end %>
  <% end %>
<% else %>
  <p>This subject has no sections yet.</p>
<% end %>

<div>
  <%= link_to "Edit this subject", edit_subject_path(@subject) %> |
  <%= link_to "Back to subjects", subjects_path %>

  <%= button_to "Destroy this subject", @subject, method: :delete %>
</div>

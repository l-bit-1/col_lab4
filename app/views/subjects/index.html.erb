<% content_for :title, "Subjects" %>

<% if notice.present? %>
  <div class="alert alert-success alert-dismissible glass rounded-4 fade show" role="alert">
    <%= notice %>
    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
  </div>
<% end %>

<%= render "shared/page_header",
      title: "Subjects",
      subtitle: "What is taught and who teaches it.",
      new_path: new_subject_path,
      new_label: "New subject" %>

<% if @subjects.any? %>
  <%# Summary strip %>
  <% units = @subjects.sum { |s| s.number_of_units.to_i } %>
  <div class="card-grid card-grid--compact mb-4">
    <% [
      ["bi-book",         @subjects.size,                                    "Subjects"],
      ["bi-layers",       units,                                             "Total units"],
      ["bi-person-badge", @subjects.map(&:teacher_id).compact.uniq.size,     "Teachers involved"],
      ["bi-collection",   @subjects.sum { |s| s.sections.size },             "Sections"]
    ].each do |icon, value, label| %>
      <div class="card">
        <div class="card-body d-flex align-items-center gap-3 py-3">
          <i class="bi <%= icon %> fs-3 text-navy"></i>
          <div>
            <div class="fs-4 fw-bold lh-1"><%= value %></div>
            <small class="text-body-secondary"><%= label %></small>
          </div>
        </div>
      </div>
    <% end %>
  </div>

  <%# Subject cards %>
  <div id="subjects" class="card-grid mb-4">
    <% @subjects.each do |subject| %>
      <div class="card stat-card h-100 position-relative">
        <div class="card-body">
          <div class="d-flex align-items-start justify-content-between gap-2 mb-3">
            <h2 class="h5 mb-0">
              <%= link_to subject.name, subject_path(subject),
                    class: "stretched-link text-decoration-none text-body" %>
            </h2>
            <i class="bi bi-book text-navy fs-4"></i>
          </div>

          <ul class="list-unstyled small text-body-secondary mb-3 d-grid gap-1">
            <li>
              <i class="bi bi-person-badge me-2"></i>
              <%= subject.teacher&.name || "No teacher assigned" %>
            </li>
            <% if subject.respond_to?(:number_of_units) && subject.number_of_units.present? %>
              <li><i class="bi bi-layers me-2"></i><%= subject.number_of_units %> units</li>
            <% end %>
          </ul>

          <span class="badge text-bg-light border">
            <%= pluralize(subject.sections.size, "section") %>
          </span>
        </div>
      </div>
    <% end %>
  </div>
<% else %>
  <div class="glass rounded-4 p-5 text-center text-body-secondary">
    <i class="bi bi-book fs-1 d-block mb-2"></i>
    No subjects yet.
  </div>
<% end %>
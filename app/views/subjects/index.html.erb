<p style="color: green"><%= notice %></p>

<% content_for :title, "Subjects" %>

<h1>Subjects</h1>

<div id="subjects" class="row g-1">
  <% @subjects.each do |subject| %>
    <div class="col-md-3">
      <div class="card">
        <div class="card-body">
          <%= render subject %>

          <%= link_to "Show this subject",
              subject,
              class: "btn btn-primary mt-2" %>
        </div>
      </div>
    </div>
  <% end %>
</div>

<div class="mt-4">
  <%= link_to "New subject",
      new_subject_path,
      class: "btn btn-success" %>
</div>
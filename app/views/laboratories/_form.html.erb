<%= simple_form_for(laboratory) do |form| %>
  <% if laboratory.errors.any? %>
    <div class="alert alert-danger">
      <h5>
        <%= pluralize(laboratory.errors.count, "error") %>
        prohibited this laboratory from being saved:
      </h5>

      <ul class="mb-0">
        <% laboratory.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="mb-3">
    <%= form.input :name,
                   label: "Laboratory Name",
                   input_html: { class: "form-control" } %>
  </div>

  <div class="mb-3">
    <%= form.input :location,
                   label: "Location",
                   input_html: { class: "form-control" } %>
  </div>

  <div class="mb-3">
    <%= form.input :department_id,
                   label: "Department",
                   collection: Department.order(:name),
                   value_method: :id,
                   label_method: :name,
                   prompt: "Select a department",
                   input_html: { class: "form-select" } %>
  </div>

  <div class="mt-4">
    <%= form.button :submit, class: "btn btn-primary" %>
  </div>
<% end %>
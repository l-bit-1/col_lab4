<%= simple_form_for teacher do |form| %>
  <% if teacher.errors.any? %>
    <div class="alert alert-danger">
      <h5>
        <%= pluralize(teacher.errors.count, "error") %>
        prohibited this teacher from being saved:
      </h5>

      <ul class="mb-0">
        <% teacher.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%= form.input :name,
                 input_html: { class: "form-control" } %>

  <%= form.input :email,
                 input_html: { class: "form-control" } %>

  <%= form.input :specialization,
                 input_html: { class: "form-control" } %>

  <%= form.input :department_id,
                 label: "Department",
                 collection: Department.order(:name),
                 label_method: :name,
                 value_method: :id,
                 prompt: "Select a department",
                 input_html: { class: "form-select" } %>

  <%= form.input :per_unit_rate,
                 label: "Per Unit Rate (₱)",
                 input_html: {
                   step: 0.01,
                   class: "form-control"
                 } %>

  <div class="mt-4">
    <%= form.button :submit, class: "btn btn-primary" %>
  </div>
<% end %>
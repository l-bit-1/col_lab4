<p style="color: green"><%= notice %></p>

<% content_for :title, "Teachers" %>

<h1>Teachers</h1>

<div id="teachers" class ="row">
  <% @teachers.each do |teacher| %>
    <div class="col-auto me-5">
    <%= render teacher %>
    <p>
      <%= link_to "Show this teacher", teacher %>
    </p>
    </div>
  <% end %>
</div>

<%= link_to "New teacher", new_teacher_path %>

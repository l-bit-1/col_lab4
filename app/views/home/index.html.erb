<%# Backdrop photo (same as before) %>
<div class="home-backdrop" data-controller="backdrop" data-backdrop-distance-value="800">  <div class="home-backdrop__image"
       data-backdrop-target="image"
       style="background-image: url('<%= asset_path("ateneo_de_naga.jpg") %>')"></div>
  <div class="home-backdrop__fade"></div>
  <div class="home-backdrop__veil" data-backdrop-target="veil"></div>
</div>

<%# Hero: short, left-aligned so the building stays visible on the right %>
<section class="home-hero">
  <div class="glass rounded-4 p-4 p-md-5 home-hero__panel">
    <h1 class="fw-bold mb-1">Department Student Directory</h1>
    <p class="text-body-secondary mb-3">Search for a student, or jump to any section below.</p>

    <div class="position-relative"
         data-controller="autocomplete"
         data-autocomplete-url-value="<%= search_students_path %>">
      <input type="search"
             class="form-control form-control-lg"
             placeholder="Search student name..."
             autocomplete="off"
             data-autocomplete-target="input"
             data-action="input->autocomplete#search keydown->autocomplete#keydown">
      <div class="list-group position-absolute w-100 shadow autocomplete-menu"
           data-autocomplete-target="menu" hidden></div>
    </div>
  </div>
</section>

<%# One card per entity: whole card is the "view all" link, + is "add new" %>
<% cards = [
  { label: "Students",    count: Student.count,    icon: "bi-people",       path: students_path,    new: new_student_path },
  { label: "Teachers",    count: Teacher.count,    icon: "bi-person-badge", path: teachers_path,    new: new_teacher_path },
  { label: "Departments", count: Department.count, icon: "bi-building",     path: departments_path, new: new_department_path },
  { label: "Subjects",    count: Subject.count,    icon: "bi-book",         path: subjects_path,    new: new_subject_path },
  { label: "Sections",    count: Section.count,    icon: "bi-collection",   path: sections_path,    new: new_section_path },
  { label: "Class Lists", count: Classlist.distinct.count(:section_id),  icon: "bi-list-check",   path: classlists_path,  new: new_classlist_path }
] %>

<section class="mb-4">
  <div class="row row-cols-1 row-cols-sm-2 row-cols-xl-3 g-3">
    <% cards.each do |c| %>
      <div class="col">
        <div class="card glass stat-card h-100 position-relative">
          <div class="card-body d-flex align-items-center gap-3">
            <i class="bi <%= c[:icon] %> fs-2 text-navy"></i>
            <div class="flex-grow-1">
              <div class="fs-2 fw-bold lh-1"><%= c[:count] %></div>
              <%= link_to c[:label], c[:path],
                    class: "stretched-link text-decoration-none text-body-secondary" %>
            </div>
            <%= link_to "+", c[:new],
                  class: "btn btn-sm btn-outline-secondary position-relative",
                  style: "z-index: 2;",
                  title: "Add #{c[:label].downcase.singularize}" %>
          </div>
        </div>
      </div>
    <% end %>
  </div>
</section>

<%# Faculty as compact chips: looks fine with 1 teacher or 50 %>
<section class="mb-5">
  <h2 class="h5 mb-3">Faculty</h2>
  <div class="d-flex flex-wrap gap-2">
    <% Teacher.includes(:department).order(:name).limit(12).each do |teacher| %>
     <%= link_to teacher_path(teacher),
      class: "glass rounded-pill d-inline-flex align-items-center gap-2 py-1 ps-1 pe-3 text-decoration-none text-body" do %>
  <span class="avatar-chip"><%= teacher.name.to_s.first.upcase %></span>
  <span>
    <%= teacher.name %>
    <small class="text-body-secondary">· <%= teacher.department&.name %></small>
  </span>
<% end %>
    <% end %>
  </div>
</section>
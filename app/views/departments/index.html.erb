<p style="color: green"><%= notice %></p>

<% content_for :title, "Departments" %>

<h1>Departments</h1>

<div id="departments" class="row g-1">
  <% @departments.each do |department| %>
    <div class="col-md-3">
      <%= render department %>
    </div>
  <% end %>
</div>

<div class="mt-4">
  <%= link_to "New department",
      new_department_path,
      class: "btn btn-success" %>
</div>
<p style="color: green"><%= notice %></p>

<% content_for :title, "Departments" %>

<h1>Departments</h1>

<div id="departments" class ="row">
  <% @departments.each do |department| %>
    <div class = "col-auto me-5">
    <%= render department %>
    <p>
      <%= link_to "Show this department", department %>
    </p>
    </div>
  <% end %>
</div>

<%= link_to "New department", new_department_path %>

<p style="color: green"><%= notice %></p>

<%= render @department %>
<h3>List of Teachers:</h3>
<% if @department.teachers.any? %>
  <ul>
    <% @department.teachers.each do |teacher| %>
      <li>
        <%= teacher.name %> -
        <%= teacher.email %> -
        <%= teacher.specialization %>
        </li>
    <% end %>
</ul>
<% end %>

<h3>Used Laboratories:</h3>
<% if @department.laboratories.any? %>
      <ul>
        <% @department.laboratories.each do |laboratory| %>
          <li>
          <%= laboratory.name %>
          <%= laboratory.location %>
          </li>
      <% end %>
</ul>
<% end %>

<% if @department.students.any? %>
  <h3>List of estudyent:</h3>
  <table>
    <thead>
      <tr>
        <th>Name</th>
        <th>Program</th>
        <th>Year Level</th>
      </tr>
    </thead>
    <tbody>
      <% @department.students.each do |student| %>
        <tr>
          <td><%= student.name %></td>
          <td><%= student.program %></td>
          <td><%= student.year_level%></td>
        </tr>
        <% end %>
        </tbody>
        </table>
        <% end %>

<div>
  <%= link_to "Edit this department", edit_department_path(@department) %> |
  <%= link_to "Back to departments", departments_path %>

  <%= button_to "Destroy this department", @department, method: :delete %>
</div>

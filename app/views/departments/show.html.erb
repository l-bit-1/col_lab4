<p style="color: green"><%= notice %></p>

<div class="col-md-2">
  <%= render "department_info", department: @department %>
</div>  
<h3>List of Teachers:</h3>
<% if @department.teachers.any? %>
  <ul>
    <% @department.teachers.each do |teacher| %>
      <li>
        <%= teacher.name %> -
        <%= teacher.email %> -
        <%= teacher.specialization %>
        </li>
    <% end %>
</ul>
<% else %>
  <p class="text-muted fst-italic">Wow, such empty.</p>
<% end %>

<h3>Used Laboratories:</h3>
<% if @department.laboratories.any? %>
      <ul>
        <% @department.laboratories.each do |laboratory| %>
          <li>
          <%= laboratory.name %> —
          <%= laboratory.location %>
          </li>
      <% end %>
</ul>
<% else %>
  <p class="text-muted fst-italic">Wow, such empty.</p>
<% end %>


<h3>List of estudyent:</h3>
<% if @department.students.any? %>
  <table class="table">
  <thead>
    <tr>
      <th class="pe-5">Name</th>
      <th class="pe-5">Program</th>
      <th>Year Level</th>
    </tr>
  </thead>

  <tbody>
    <% @department.students.each do |student| %>
      <tr>
        <td class="pe-5"><%= student.name %></td>
        <td class="pe-5"><%= student.program %></td>
        <td><%= student.year_level %></td>
      </tr>
    <% end %>
  </tbody>
</table>
        <% else %>
  <p class="text-muted fst-italic">Wow, such empty.</p>
        <% end %>

<div class="d-flex gap-2">
  <%= link_to "Edit this department",
      edit_department_path(@department),
      class: "btn btn-warning" %>

  <%= link_to "Back to departments",
      departments_path,
      class: "btn btn-secondary" %>

  <%= button_to "Destroy this department",
      @department,
      method: :delete,
      class: "btn btn-danger" %>
</div>

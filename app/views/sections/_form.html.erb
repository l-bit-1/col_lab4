<%= simple_form_for(section) do |form| %>
  <% if section.errors.any? %>
    <div class="alert alert-danger">
      <h5>
        <%= pluralize(section.errors.count, "error") %>
        prohibited this section from being saved:
      </h5>

      <ul class="mb-0">
        <% section.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="mb-3">
    <%= form.input :name,
                   label: "Section Name",
                   input_html: { class: "form-control" } %>
  </div>

  <div class="mb-3">
    <%= form.input :room,
                   label: "Room",
                   input_html: { class: "form-control" } %>
  </div>

  <div class="mb-3">
    <%= form.input :timeslot,
                   label: "Timeslot",
                   input_html: { class: "form-control" } %>
  </div>

  <div class="mb-3">
    <%= form.input :subject_id,
                   label: "Subject",
                   collection: Subject.order(:name),
                   value_method: :id,
                   label_method: :name,
                   prompt: "Select a subject",
                   input_html: { class: "form-select" } %>
  </div>

  <div class="mt-4">
    <%= form.button :submit, class: "btn btn-primary" %>
  </div>
<% end %>
<div id="<%= dom_id section %>" class="card mb-3 shadow-sm">
  <div class="card-body">

    <h5 class="card-title mb-3">
      <%= section.name %>
    </h5>

    <div class="mb-2">
      <strong>Subject:</strong>
      <%= section.subject.name %>
    </div>

    <div class="mb-2">
      <strong>Teacher:</strong>
      <%= section.subject.teacher.name %>
    </div>

    <div class="mb-2">
      <strong>Room:</strong>
      <%= section.room %>
    </div>

    <div>
      <strong>Timeslot:</strong>
      <%= section.timeslot %>
    </div>

  </div>
</div>

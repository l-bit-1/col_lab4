<p style="color: green"><%= notice %></p>

<%= render @section %>

<% if @section.classlists.any? %>
  <h3>List of Students:</h3>
  <table>
    <thead> 
      <tr>
        <th>Name</th>
        <th>Year Level</th>
        <th>Program</th>

      </tr>
    </thead>
    <tbody>
      <% @section.classlists.each do |classlist| %>
        <tr>
          <td><%= classlist.student.name %></td>
          <td><%= classlist.student.year_level %></td>
          <td><%= classlist.student.program %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% end %>

<div>
  <%= link_to "Edit this section", edit_section_path(@section) %> |
  <%= link_to "Back to sections", sections_path %>

  <%= button_to "Destroy this section", @section, method: :delete %>
</div>

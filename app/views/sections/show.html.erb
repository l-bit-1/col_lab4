<p style="color: green"><%= notice %></p>

<%= render @section %>

<h3>List of Students:</h3>
<% if @section.classlists.any? %>
  <table class="table">
    <thead> 
      <tr>
        <th class="pe-5">Name</th>
        <th class="pe-5">Program</th>
        <th>Year Level</th>

      </tr>
    </thead>

    <tbody>
    <% @section.classlists.each do |classlist| %>
        <tr>
          <td class="pe-5"><%= classlist.student.name %></td>
          <td class="pe-5"><%= classlist.student.program %></td>
          <td><%= classlist.student.year_level %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% end %>

<div class="d-flex gap-2">
  <%= link_to "Edit this section",
      edit_section_path(@section),
      class: "btn btn-warning" %>

  <%= link_to "Back to sections",
      sections_path,
      class: "btn btn-secondary" %>

  <%= button_to "Destroy this section",
      @section,
      method: :delete,
      class: "btn btn-danger" %>
</div>

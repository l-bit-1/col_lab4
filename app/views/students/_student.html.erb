<dl class="row mb-0" id="<%= dom_id student %>">
  <dt class="col-5 text-muted fw-normal">Name</dt>
  <dd class="col-7 fw-semibold"><%= student.name %></dd>

  <dt class="col-5 text-muted fw-normal">Year Level</dt>
  <dd class="col-7"><%= student.year_level %></dd>

  <dt class="col-5 text-muted fw-normal">Program</dt>
  <dd class="col-7"><%= student.program %></dd>

  <dt class="col-5 text-muted fw-normal">Department</dt>
  <dd class="col-7 mb-0"><%= student.department.name %></dd>
</dl>

<%= simple_form_for student do |form| %>
  <% if student.errors.any? %>
    <div class="alert alert-danger">
      <h5>
        <%= pluralize(student.errors.count, "error") %>
        prohibited this student from being saved:
      </h5>

      <ul class="mb-0">
        <% student.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%= form.input :name,
                 label: "Student Name",
                 input_html: { class: "form-control" } %>

  <%= form.input :year_level,
                 label: "Year Level",
                 collection: 1..4,
                 prompt: "Select year level",
                 input_html: { class: "form-select" } %>

  <%= form.input :program,
                 label: "Program",
                 input_html: { class: "form-control" } %>

  <%= form.input :department_id,
                 label: "Department",
                 collection: Department.order(:name),
                 label_method: :name,
                 value_method: :id,
                 prompt: "Select a department",
                 input_html: { class: "form-select" } %>

  <div class="mt-4">
    <%= form.button :submit, class: "btn btn-primary" %>
  </div>
<% end %>
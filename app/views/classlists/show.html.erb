<p style="color: green"><%= notice %></p>

<%= render @classlist %>

<div class="d-flex gap-2">
  <%= link_to "Edit this student",
      edit_classlist_path(@classlist),
      class: "btn btn-warning" %>

  <%= link_to "Back to classlists",
      classlists_path,
      class: "btn btn-secondary" %>

  <%= button_to "Remove from classlist",
      @classlist,
      method: :delete,
      class: "btn btn-danger" %>
</div>
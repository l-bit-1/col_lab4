<% content_for :title, "Classlists" %>

<%= render "shared/page_header",
      title: "Classlists",
      subtitle: "Who is enrolled in each section.",
      new_path: new_classlist_path,
      new_label: "New classlist" %>

<% if @classlists.any? %>
  <div id="classlists" class="card-grid mb-4">
    <% @classlists.group_by(&:section).each do |section, classlists| %>
      <div class="card h-100">
        <div class="card-header bg-transparent d-flex align-items-center justify-content-between">
          <h2 class="h5 mb-0">
            <%= section&.subject&.name || "No subject" %> - <%= section&.name || "No section" %>
          </h2>
          <span class="badge text-bg-light border"><%= classlists.size %></span>
        </div>

        <div class="list-group list-group-flush">
          <% classlists.each do |classlist| %>
            <div class="list-group-item d-flex align-items-center justify-content-between gap-2">
              <%= link_to classlist.student&.name || "Unknown student", classlist,
                    class: "fw-semibold text-decoration-none text-body" %>

              <% if admin? %>
                <div class="d-inline-flex gap-1">
                  <%= link_to edit_classlist_path(classlist),
                        class: "btn btn-sm btn-outline-secondary", title: "Edit" do %>
                    <i class="bi bi-pencil"></i>
                  <% end %>
                  <%= button_to classlist_path(classlist), method: :delete,
                        class: "btn btn-sm btn-outline-danger", title: "Remove from section",
                        form: { data: { turbo_confirm: "Remove #{classlist.student&.name} from this section?" } } do %>
                    <i class="bi bi-trash"></i>
                  <% end %>
                </div>
              <% end %>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>
<% else %>
  <div class="glass rounded-4 p-5 text-center text-body-secondary">
    <i class="bi bi-list-check fs-1 d-block mb-2"></i>
    No class lists yet.
  </div>
<% end %>
<p style="color: green"><%= notice %></p>

<% content_for :title, "Classlists" %>

<h1>Classlists</h1>

<div id="classlists">
  <% @classlists.group_by(&:section).each do |section, classlists| %>
    <div class="mb-4">
      <h3>
        <%= section.subject.name %> - <%= section.name %>
      </h3>

      <div class="row">
        <% classlists.each do |classlist| %>
          <div class="col-auto me-5">
            <%= render classlist %>
            <p>
              <%= link_to "Show this classlist", classlist %>
            </p>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>
</div>

<%= link_to "New classlist", new_classlist_path %>
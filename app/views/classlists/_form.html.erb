<%= simple_form_for classlist do |form| %>
  <% if classlist.errors.any? %>
    <div class="alert alert-danger">
      <h5>
        <%= pluralize(classlist.errors.count, "error") %>
        prohibited this classlist from being saved:
      </h5>

      <ul class="mb-0">
        <% classlist.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="mb-3">
    <%= form.label :section_id, "Section", class: "form-label" %>

    <%= form.input_field :section_id,
                         collection: Section.includes(:subject).order(:name),
                         label_method: :display_name,
                         value_method: :id,
                         prompt: "Select a section",
                         class: "form-select" %>
  </div>

  <div class="mb-3">
    <%= form.label :student_id, "Student", class: "form-label" %>

    <%= form.input_field :student_id,
                         collection: Student.order(:name),
                         label_method: :name,
                         value_method: :id,
                         prompt: "Select a student",
                         class: "form-select" %>
  </div>

  <div class="mt-4">
    <%= form.button :submit, class: "btn btn-primary" %>
  </div>
<% end %>
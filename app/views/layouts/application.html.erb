<!DOCTYPE html>
<html>
<head>
  <title><%= content_for(:title) || "myADNU LARPER" %></title>
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="application-name" content="Department Student Application">
  <meta name="mobile-web-app-capable" content="yes">
  <meta name="view-transition" content="same-origin">
  <% if logged_in? %>
    <meta name="turbo-cache-control" content="no-cache">
  <% end %>

  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>
  <%= yield :head %>

  <link rel="icon" href="/icon.png" type="image/png">
  <link rel="icon" href="/icon.svg" type="image/svg+xml">
  <link rel="apple-touch-icon" href="/icon.png">

  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">

  <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
  <%= javascript_importmap_tags %>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" defer></script>
</head>

<body data-controller="arrow-nav" data-action="keydown->arrow-nav#key">
  <% if logged_in? %>
    <% unless current_page?(root_path) %>
      <div class="home-backdrop home-backdrop--compact">
        <div class="home-backdrop__image"
             style="background-image: url('<%= asset_path("ateneo_de_naga.jpg") %>')"></div>
        <div class="home-backdrop__fade"></div>
        <div class="home-backdrop__veil"></div>
      </div>
    <% end %>

    <div class="d-md-none bg-dark text-white p-2">
      <button class="btn btn-sm btn-dark" type="button" data-bs-toggle="offcanvas" data-bs-target="#sidebar">
        &#9776; Menu
      </button>
      <span class="ms-2">Department Student Application</span>
    </div>

    <div class="d-flex">
      <button class="sidebar-tab d-none d-md-flex" type="button" data-sidebar-toggle aria-label="Toggle sidebar">
        <i class="bi bi-chevron-left"></i>
      </button>

      <div class="offcanvas-md offcanvas-start bg-dark text-white flex-shrink-0 min-vh-100"
           id="sidebar" data-turbo-permanent style="width: 230px">

        <div class="offcanvas-header">
          <h5 class="offcanvas-title">Menu</h5>
          <button type="button" class="btn-close btn-close-white" data-bs-dismiss="offcanvas" data-bs-target="#sidebar"></button>
        </div>

        <div class="offcanvas-body d-flex flex-column p-3">
          <%= image_tag "/adnulogo.png", alt: "Ateneo De Naga University Logo", class: "school-logo mb-2" %>

          <h5 class="d-none d-md-block mb-1">MyADNU LARPER</h5>
          <small class="d-none d-md-block mb-3 fst-italic">Academic Management System</small>

          <div class="sidebar-nav" data-controller="sidebar-pill">
            <ul class="nav nav-pills flex-column gap-1">
              <li class="nav-item"><%= sidebar_link "Home", root_path, "home", "bi-house-door" %></li>
              <li class="nav-item"><%= sidebar_link "Departments", departments_path, "departments", "bi-building" %></li>
              <li class="nav-item"><%= sidebar_link "Teachers", teachers_path, "teachers", "bi-person-badge" %></li>
              <li class="nav-item"><%= sidebar_link "Subjects", subjects_path, "subjects", "bi-book" %></li>
              <li class="nav-item"><%= sidebar_link "Sections", sections_path, "sections", "bi-collection" %></li>
              <li class="nav-item"><%= sidebar_link "Students", students_path, "students", "bi-people" %></li>
              <li class="nav-item"><%= sidebar_link "Class Lists", classlists_path, "classlists", "bi-list-check" %></li>
              <li class="nav-item"><%= sidebar_link "Laboratories", laboratories_path, "laboratories", "bi-pc-display" %></li>
            </ul>
          </div>

          <div class="mt-auto pt-4 border-top border-secondary">
            <div class="text-white mb-2">
              <i class="bi bi-person-circle me-2"></i>
              <%= current_user.email %>
            </div>

            <small class="text-secondary d-block mb-3">
              Role: <%= current_user.role.capitalize %>
            </small>

            <%= button_to session_path, method: :delete, class: "btn btn-danger btn-sm w-100" do %>
              <i class="bi bi-box-arrow-right me-2"></i>
              Logout
            <% end %>
          </div>
        </div>
      </div>

      <main class="flex-grow-1 p-4" style="min-width: 0">
        <div class="container-fluid px-4 pt-3">
          <%= render_breadcrumbs %>

          <% flash.each do |type, message| %>
            <% alert_class = case type.to_sym
                             when :alert then "alert-danger"
                             when :notice then "alert-success"
                             else "alert-info"
                             end %>
            <div class="alert <%= alert_class %> alert-dismissible fade show mt-3" role="alert">
              <%= message %>
              <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
          <% end %>
        </div>

        <%= yield %>
      </main>
    </div>

  <% else %>
    <% if alert.present? %>
      <div class="container mt-4">
        <div class="alert alert-danger"><%= alert %></div>
      </div>
    <% end %>
    <%= yield %>
  <% end %>
</body>
</html>